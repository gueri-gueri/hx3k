# Copy to .env and fill in. Optional: the app also asks for the key on first run.

# Your publishable key from TONE3000 → Settings → API Keys (https://www.tone3000.com/settings).
# It is the OAuth client_id and is safe to ship in a desktop app.
# Never put the secret key (t3k_cs_…) here or anywhere in this project.
MAIN_VITE_T3K_PUBLISHABLE_KEY=t3k_pub_your_key_here

# OAuth redirect URI. Nothing serves this URL: the main process intercepts the
# navigation to it inside the embedded TONE3000 view (src/main/oauth.ts).
# Loopback URIs are always accepted by TONE3000, so the default needs no registering.
# MAIN_VITE_T3K_REDIRECT_URI=http://127.0.0.1:38300/callback
