{
  "name": "hx3k",
  "productName": "HX3K",
  "version": "0.2.0",
  "private": true,
  "description": "Turns TONE3000 NAM A2 Lite captures into the User IR .wav files that HXtra's NAM A2 Lite block loads on the HX Stomp.",
  "license": "GPL-3.0-or-later",
  "homepage": "https://www.tone3000.com",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "hx:probe": "HX3K_STOMP=1 HX3K_WAV= HX3K_POINT= vitest run tests/hx.hardware.test.ts tests/device.test.ts -t \"A real HX Stomp\" --no-file-parallelism --silent=false",
    "hx:import": "HX3K_STOMP=1 vitest run tests/hx.hardware.test.ts -t import --silent=false",
    "hx:point": "HX3K_STOMP=1 vitest run tests/hx.hardware.test.ts -t point: --silent=false",
    "icon": "electron scripts/make-icon.cjs",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "devDependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "usb": "^2.19.2"
  }
}
